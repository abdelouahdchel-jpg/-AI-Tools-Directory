# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE POSTGRESQL & AUTHENTICATION CONFIGURATION
# Connect to your free Supabase project (https://supabase.com)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# PRIVILEGED SERVER-SIDE OPERATIONS ONLY (Never expose in client bundles)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# SITE CONFIGURATION
SITE_NAME="AI Tools Directory"
SITE_DESCRIPTION="Discover, compare, and manage verified artificial intelligence software."
